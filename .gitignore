# ── Agent work volumes (RAVANA's "hands" output) ──
# These are scratch directories RAVANA creates when using its agentic tools.
# They are NEVER source code and must never be committed.
_agent_work/
_agent_work_intentforge/

# ── Audit artifacts (one-off reports/scripts, never source) ──
audit_msg_*.txt
audit_report_*.md
audit_run_*.sh
probe_facts.py

# ── Benchmark/run artifacts ──
benchmark_results/

# ── WORKER SCRATCH (founder convention: 2026-08-29) ──
# Autonomous loop workers (Hermes kanban) MUST dump all dirty/temp/throwaway
# artifacts here — NEVER in the repo root. Files here are gitignored so they
# can NEVER be committed, even by `git add -A`. If a worker needs a scratch
# file, it goes in scratch/ (or tmp/). Root-level _*.py / verify_*.sh are
# banned from the tracked tree.
scratch/
tmp/
_*.py
!__init__.py
verify_*.sh
*.tmp
*_tmp.py

# ── Temporary & Scratch ──
scratch/
fix_*.py
apply_phase*.py
clean_phase*.py
implement_phase*.py
ravana_phase*.py
*_indent_analysis.txt
_indent_out.txt

# ── Exports ──
test_export.json
test_graph.json

# ── OS Files ──
.DS_Store
nul

.poolside/
temp/
# ── Local QA / agent scratch (DO NOT COMMIT) ──
# Briefs, plans, audit logs, and throwaway debug scripts live here.
# This directory is git-ignored on purpose — it holds per-round working files
# (opencode briefs/plans, auditor notes, patch files, one-off debug runs).
# Never 'git add' anything under .hermes-qa/ — it is local scratch.
.hermes-qa/

# Local throwaway directory for debug scripts, patch files, and experiments.
# Git-ignored by design. Put ad-hoc probes / scratch fixes here, NOT in scripts/.
tmp/

# ── Runtime-generated state (NOT committed) ──
# RAVANA rewrites this at runtime (factual-bias store). It is generated state,
# not hand-authored config, so ignore it to keep the tree clean.
data/case_dist.json

# Generated pytest-split duration cache (auto-generated by `pytest-split` on
# demand; referenced by NO repo code, test, doc, or CI workflow — reproducible).
.test_durations

# ── Local QA scratch (per-round, gitignored) ──
tmp/

# ── Tracked-generated artifacts removed (2026-08 round, Phase 4) ──
# These were build/run output committed to the repo by mistake. They are
# reproducible (the .bak is a vim/emacs swap-style backup; the .npz is a one-off
# experiment baseline; the .jsonl is a benchmark progress dump) and are
# referenced by NO code, test, doc, or CI workflow (verified by grep). Removed
# from the index via `git rm --cached` (local copies kept); ignore them so they
# are never re-added.
*.bak
experiments/_identity_baseline_6912.npz
benchmark_results/locomo_full_progress_PRE_20260724_185358.jsonl
node_modules/
