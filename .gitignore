# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# ── Environment ──
.env
.venv/
venv/

# ── Build Artifacts ──
build/
dist/
*.whl
*.tar.gz

# ── Runtime Data (auto-saved model weights, caches) ──
# NOTE: data/ravana_glove_cache.npz is tracked via git-lfs (critical CI dep),
# and data/*.json are committed config. Everything else under data/ is ignored.
#
# Use `data/*` (contents), NOT `data/` (the directory). Ignoring the directory
# itself means git never descends into it, so the `!data/...` re-includes below
# can never match — and the previous `data/` + `!data/` pair cancelled out
# entirely, leaving ~1.3 GB of downloaded corpora (data/glove, data/conceptnet,
# data/benchmarks, data/cache) showing as untracked and one `git add data/`
# away from being committed.
data/*
!data/*.json
!data/ravana_glove_cache.npz
!data/common_facts.json
weights/
user_models/
checkpoints/
output/

# ── Data Files ──
*.db
*.db-shm
*.db-wal
*.pickle
*.pkl
*.pkl.sha
*.npz
*.npy
*.jsonl

# ── Logs & Traces ──
*.log
cognitive_trace.json
cognitive_trace.md
compression_trace.json
compression_trace.md

# ── Models & Checkpoints ──
models/

# ── Results & Experiments ──
results/
*/results/*.json
*/results/*.txt
experiment_results/
experiment_results/*_output.txt

# ── LaTeX Build Artifacts ──
paper/*.pdf
paper/*.aux
paper/*.out

# ── Agent / LLM Files ──
.agents/
.hermes/
.openclaude/
.antigravitycli/
skills-lock.json
AGENTS.md

# ── Temporary & Scratch ──
scratch/
fix_*.py
apply_phase*.py
clean_phase*.py
implement_phase*.py
ravana_phase*.py
*_indent_analysis.txt
_indent_out.txt

# ── Exports ──
test_export.json
test_graph.json

# ── OS Files ──
.DS_Store
nul

.poolside/
temp/
# ── Local QA / agent scratch (DO NOT COMMIT) ──
# Briefs, plans, audit logs, and throwaway debug scripts live here.
# This directory is git-ignored on purpose — it holds per-round working files
# (opencode briefs/plans, auditor notes, patch files, one-off debug runs).
# Never 'git add' anything under .hermes-qa/ — it is local scratch.
.hermes-qa/

# Local throwaway directory for debug scripts, patch files, and experiments.
# Git-ignored by design. Put ad-hoc probes / scratch fixes here, NOT in scripts/.
tmp/

# ── Runtime-generated state (NOT committed) ──
# RAVANA rewrites this at runtime (factual-bias store). It is generated state,
# not hand-authored config, so ignore it to keep the tree clean.
data/case_dist.json
