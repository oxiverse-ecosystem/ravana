# ── Environment ──
.env
.venv/
venv/

# ── Build Artifacts ──
build/
dist/
*.whl
*.tar.gz

# ── Runtime Data (auto-saved model weights, caches) ──
# NOTE: data/ravana_glove_cache.npz is a regenerable GloVe projection cache.
# It is NOT committed (was previously tracked via git-lfs and burned the repo's
# 10GB LFS bandwidth quota on every CI run). The engine rebuilds it on first
# boot from the raw GloVe file, so it must stay out of version control.
# data/*.json are committed config. Everything else under data/ is ignored.
#
# Use `data/*` (contents), NOT `data/` (the directory). Ignoring the directory
# itself means git never descends into it, so the `!data/...` re-includes below
# can never match — and the previous `data/` + `!data/` pair cancelled out
# entirely, leaving ~1.3 GB of downloaded corpora (data/glove, data/conceptnet,
# data/benchmarks, data/cache) showing as untracked and one `git add data/`
# away from being committed.
data/*
!data/*.json
!data/common_facts.json
weights/
user_models/
checkpoints/
output/

